#!/usr/bin/env bash
# Clones the component repositories into this repository's components/ directory: backend/, cli/, apple/.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/clone

Clones backend, cli, and apple into components/, tracking main.
Missing repositories are cloned; existing checkouts are left alone.

ASSISTANT_LINK_GIT_BASE overrides where repositories are cloned from
(default https://github.com/assistant-link), for example git@github.com:assistant-link
or the owner of your forks.
USAGE
}

for arg in "$@"; do
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
base="${ASSISTANT_LINK_GIT_BASE:-https://github.com/assistant-link}"
repos=(backend cli apple)

status=0
for repo in "${repos[@]}"; do
  dir="$root/components/$repo"
  if [[ -e "$dir/.git" ]]; then
    echo "$repo: already cloned, left alone"
  elif [[ -e "$dir" ]]; then
    echo "$repo: $dir exists but is not a git checkout, skipped" >&2
    status=1
  else
    git clone --quiet "$base/$repo.git" "$dir"
    echo "$repo: cloned $base/$repo.git"
  fi
done
exit "$status"
